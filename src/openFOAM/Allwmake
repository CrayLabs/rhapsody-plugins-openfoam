#!/usr/bin/env bash

cd "${0%/*}" || exit 1

# Defaults only; anything already set in the environment wins
: "${RADEX_DIR:=$HOME/dev/RaDex/install}"
: "${SMARTREDIS_DIR:=$HOME/dev/hpe/SmartRedis/install}"

# Only consult Dragon if the caller did not supply the flags. pyenv installs a
# dragon-config shim that exists but fails, so test the output not the path.
if [ -z "$DRAGON_INCLUDES" ] || [ -z "$DRAGON_LIBS" ]
then
    dragon_includes=$(dragon-config -o 2>/dev/null)
    dragon_libs=$(dragon-config -l 2>/dev/null)

    if [ -z "$dragon_includes" ] || [ -z "$dragon_libs" ]
    then
        echo "Allwmake: could not get build flags from dragon-config." >&2
        echo "Activate the Dragon environment, or set the flags directly:" >&2
        echo '  export DRAGON_INCLUDES="-I/path/to/dragon/include"' >&2
        echo '  export DRAGON_LIBS="-L/path/to/dragon/lib -ldragon"' >&2
        exit 1
    fi

    : "${DRAGON_INCLUDES:=$dragon_includes}"
    : "${DRAGON_LIBS:=$dragon_libs}"
fi

find_lib_dir() {
    local install_dir="$1"
    local lib="$2"

    local dir=$(
        find "$install_dir" -type f \( \
                -name "${lib}.so" -o \
                -name "${lib}.dylib" -o \
                -name "${lib}.a" \
             \) -exec dirname {} \; -quit
    )

    if [[ -z "$dir" ]]; then
        printf 'Error: could not find %s under %s\n' "$lib" "$root" >&2
        return 1
    fi

    echo "$dir"
}

RADEX_INCLUDE_DIR="${RADEX_DIR}/include"
RADEX_LIB_DIR="$(find_lib_dir ${RADEX_DIR} libradex)"
SMARTREDIS_INCLUDE_DIR="${SMARTREDIS_DIR}/include"
SMARTREDIS_LIB_DIR="$(find_lib_dir ${SMARTREDIS_DIR} libsmartredis)"

export DRAGON_INCLUDES \
       DRAGON_LIBS \
       RADEX_INCLUDE_DIR \
       RADEX_LIB_DIR \
       SMARTREDIS_INCLUDE_DIR \
       SMARTREDIS_LIB_DIR

# Create the $FOAM_USER_LIBBIN if not existing.
# - This happens with a fresh OpenFOAM installation.
# - openfoam-smartsim libraries are placed into $FOAM_USER_LIBBIN
if [ ! -d "$FOAM_USER_LIBBIN" ];
then
    mkdir -p $FOAM_USER_LIBBIN
fi

## Compile OpenFOAM libs
wmake libso radexIO
wmake libso functionObjects/radexBase
wmake libso functionObjects/radexWrite
wmake libso functionObjects/radexRead
